# Database Configs
DATABASE_URL=postgresql+asyncpg://traffic_admin:traffic_pass@db:5432/traffic_db
# Sync URL is useful for migrations (Alembic) and seeders
DATABASE_SYNC_URL=postgresql://traffic_admin:traffic_pass@db:5432/traffic_db

# Redis URL for Celery and WebSocket caching/pubsub
REDIS_URL=redis://redis:6379/0

# Gemini API Config
GEMINI_API_KEY=your_gemini_api_key_here

# Security Settings
SECRET_KEY=4eb8d9bfd68e596da34b45efea01c80f123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenWeatherMap API (Optional)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# CORS Settings (frontend origin)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173
